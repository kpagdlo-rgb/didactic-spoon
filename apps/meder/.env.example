# Optional. Leave unset to use the explicitly deterministic diagnostic mode.
# Store real values only in .env.local or your deployment secret manager.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set to the exact externally served origin when deploying behind a reverse proxy.
# MEDER_ALLOWED_ORIGIN=https://your-preview.example
# Optional process-lifetime model admission cap, integer 1..100. Default 10.
# One model run can be active at a time. This is not user authentication.
MEDER_MODEL_RUN_BUDGET=10
